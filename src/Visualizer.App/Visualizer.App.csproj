<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- The exe carries the icon, and every window without one of its own shows it. Icon/icon.png is the source art;
         icon.ico holds 16 to 256 px cut from it. -->
    <ApplicationIcon>Icon\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Visualizer.Application/Visualizer.Application.csproj" />
    <ProjectReference Include="../Visualizer.Infrastructure/Visualizer.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Every file in Themes/Palettes is a theme; its file name is the theme id. -->
    <EmbeddedResource Include="Themes\Palettes\*.json" LogicalName="Visualizer.Themes.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Plugins ship built: every file under plugins goes beside the exe as it is, so the console's install puts one in
         place with no build tools of its own. plugins\linker is the game link mod, written there by build-mod.ps1. -->
    <None Include="..\..\plugins\**\*" Link="plugins\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
