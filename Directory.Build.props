<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- App version shown in the main window. Raise the last number with every update (AGENTS.md). -->
    <Version>1.0.7</Version>
    <!-- The date this version was applied, shown by the console's "version" command. Update it together with Version. -->
    <VersionDate>2026-10-13</VersionDate>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="VersionDate" Value="$(VersionDate)" />
  </ItemGroup>
</Project>
